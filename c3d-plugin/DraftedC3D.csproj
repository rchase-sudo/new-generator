<Project Sdk="Microsoft.NET.Sdk">
  <!-- Civil 3D 2027 plugin: DRAFTEDIMPORT builds native Civil 3D objects from a Drafted export package.
       Compiles anywhere (CI on Linux) against Autodesk's reference NuGet packages; runs inside Civil 3D 2027+. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DraftedC3D</AssemblyName>
    <RootNamespace>Drafted.C3D</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;NU1701;NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Civil3D.NET" Version="$(Civil3DNetVersion)" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
